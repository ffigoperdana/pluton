# Force LF line endings for git hooks (required for shebang on Windows)
.githooks/* text eol=lf
deploy/*.sh text eol=lf
deploy/compose.yml text eol=lf
deploy/*.py text eol=lf
deploy/*.cjs text eol=lf
scripts/__tests__/*_test.py text eol=lf
scripts/__tests__/fixtures/deployment/*.yml text eol=lf
Dockerfile.source text eol=lf
.github/workflows/*.yml text eol=lf
# The Agent S3 probe and its lab files run on Linux
scripts/diagnostics/*.sh text eol=lf
scripts/diagnostics/test/agent-s3-probe/* text eol=lf

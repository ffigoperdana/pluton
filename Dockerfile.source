# syntax=docker/dockerfile:1.7
#
# Source-built production image used by the GitHub Container Registry workflow.
# The top-level Dockerfile remains the release-asset image that consumes the
# pre-built executables produced by scripts/build-executables.js.

ARG NODE_IMAGE=node:24.16.0-alpine
ARG RESTIC_IMAGE=restic/restic:0.19.1
ARG RCLONE_IMAGE=rclone/rclone:1.75.1

FROM ${RESTIC_IMAGE} AS restic
FROM ${RCLONE_IMAGE} AS rclone

FROM ${NODE_IMAGE} AS build

RUN apk add --no-cache python3 make g++ && corepack enable && corepack prepare pnpm@10.20.0 --activate

WORKDIR /workspace

# Copy manifests and root lifecycle scripts before installing. The root prepare
# script depends on scripts/setup-git-hooks.js.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY scripts ./scripts
COPY backend ./backend
COPY frontend ./frontend

RUN pnpm install --frozen-lockfile

# The backend build copies the built frontend into backend/public.
RUN pnpm --filter @plutonhq/core-frontend build && pnpm --filter @plutonhq/core-backend build

FROM ${NODE_IMAGE} AS production-dependencies

RUN apk add --no-cache python3 make g++ && corepack enable && corepack prepare pnpm@10.20.0 --activate

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY scripts ./scripts
COPY backend/package.json ./backend/package.json
COPY frontend/package.json ./frontend/package.json

# Keep the package-manager layout intact. backend/node_modules resolves into
# the root virtual store at runtime, so both are copied into the final image.
RUN pnpm install --prod --frozen-lockfile

FROM ${NODE_IMAGE} AS production

ARG APP_VERSION=unknown
ARG IMAGE_SOURCE=unknown
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.source="${IMAGE_SOURCE}" org.opencontainers.image.revision="${VCS_REF}" org.opencontainers.image.version="${APP_VERSION}" org.opencontainers.image.created="${BUILD_DATE}"

RUN apk add --no-cache ca-certificates wget && addgroup -S -g 10001 pluton && adduser -S -u 10001 -G pluton pluton
RUN mkdir -p /app/backend /app/drizzle /data/config /data/db /data/logs /data/progress /data/stats /data/sync /data/rescue

WORKDIR /app

COPY --from=production-dependencies /workspace/node_modules ./node_modules
COPY --from=production-dependencies /workspace/backend/node_modules ./backend/node_modules
COPY --from=production-dependencies /workspace/backend/package.json ./backend/package.json
COPY --from=build /workspace/backend/dist ./backend/dist
COPY --from=build /workspace/backend/public ./backend/public
COPY --from=build /workspace/backend/drizzle ./drizzle
COPY --from=build /workspace/backend/loader.mjs ./backend/loader.mjs
COPY --from=restic /usr/bin/restic /usr/local/bin/restic
COPY --from=rclone /usr/local/bin/rclone /usr/local/bin/rclone

RUN printf '%s\n' '#!/bin/sh' 'exec /usr/local/bin/rclone --config /data/config/rclone.conf "$$@"' > /usr/local/bin/prclone
RUN printf '%s\n' '#!/bin/sh' 'export RCLONE_CONFIG=/data/config/rclone.conf' 'exec /usr/local/bin/restic -o rclone.program=/usr/local/bin/rclone "$$@"' > /usr/local/bin/prestic
RUN chmod 0755 /usr/local/bin/restic /usr/local/bin/rclone /usr/local/bin/prclone /usr/local/bin/prestic && chown -R pluton:pluton /app /data

ENV NODE_ENV=production IS_DOCKER=true SERVER_PORT=5173 APP_VERSION=${APP_VERSION} PLUTON_DATA_DIR=/data PATH="/usr/local/bin:${PATH}"

EXPOSE 5173
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 CMD wget --no-verbose --tries=1 --spider "http://127.0.0.1:${SERVER_PORT}/api/health" || exit 1

USER pluton

CMD ["node", "--loader", "./backend/loader.mjs", "./backend/dist/index.js"]

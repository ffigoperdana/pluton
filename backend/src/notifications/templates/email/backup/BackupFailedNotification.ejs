<div>
	<div class="center">
		<h2 class="title title-error">

			<a href="<%= appUrl %>/plan/<%= plan.id %>"><%= plan.title %></a> Failed!
		</h2>
	</div>
	<!-- Basic ERROR Info -->
	<div class="backupError">
		<span class="backupErrorTitle"
			><i class="img-icon">

			</i>
			<strong>Backup Failed</strong></span
		>
		<p>Error: <%= error %></p>
	</div>
	<% if (typeof problem !== 'undefined' && problem) { %>
	<!-- Explanation of the closed failure category -->
	<div style="margin: 0 30px 20px; color: #3d3f5c; font-size: 13px; line-height: 1.6">
		<div style="font-size: 14px; font-weight: 700; color: #1d1f2b"><%= problem.title %></div>
		<p style="margin: 6px 0 0"><%= problem.detail %></p>
		<div style="margin: 16px 0 6px; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #8a93b8">
			What to do
		</div>
		<ol style="margin: 0; padding-left: 20px">
			<% problem.steps.forEach(function (step) { %><li style="margin-bottom: 4px"><%= step %></li><% }) %>
		</ol>
		<% if (problem.guideUrl) { %>
		<p style="margin: 12px 0 0"><a href="<%= problem.guideUrl %>" style="color: #575aff; font-weight: 600">Troubleshooting guide</a></p>
		<% } %>
	</div>
	<% } %>

	<!-- Basic Summary Info -->
	<div class="backupSummary">
		<div class="backupSummary_basic">
			<table role="presentation" cellpadding="0" cellspacing="0">
				<tr class="backupSummary_title">
					<td style="text-align: left">
						<i class="img-icon">

						</i>
						<strong>Failed to Backup <%= plan.sourceConfig.includes.length || 0 %> sources</strong>
					</td>
					<td style="text-align: left"></td>
					<td style="text-align: right">
						<i class="img-icon"
							></i>
						Duration:
						<strong><%= formatDuration(stats?.total_duration || 0) %></strong>
					</td>
				</tr>
				<tr class="backupSummary_details">
					<td style="text-align: left">
						<span><strong><%= deviceName %></strong></span>
						<span>Device</span>
					</td>
					<td style="text-align: center; width: 4%">
						<span class="backupSummary_arrow">➝</span>
					</td>
               <td style="text-align: right">
                  <span><strong><%= storageName %></strong></span>
                  <span>
                     <% if (replicationStorages > 0) { %>
                        + <%= replicationStorages %> More
                     <% } else { %>
                        <%= storageTypeName %><% } %>
                  </span>
               </td>
				</tr>
			</table>
		</div>
	</div>
	<!-- Basic Date and Time -->
	<div class="backupDateTime">
		<table role="presentation" cellpadding="0" cellspacing="0">
			<tr class="backupSummary_date">
				<td style="text-align: left">
					<i class="img-icon"
						></i>
					Started At:
				</td>
				<td style="text-align: right"><%= startDate %></td>
			</tr>
			<tr class="backupSummary_date">
				<td style="text-align: left">

					Failed At:
				</td>
				<td style="text-align: right"><%= endDate %></td>
			</tr>
		</table>
	</div>

	<!-- Notification Settings Info -->
	<div class="center notificationMsg">
		<p>
			You are receiving this email because you've enabled Email Notification for this backup Plan.
			You can customize the Notification Settings
			<a href="<%= appUrl %>/plan/<%= plan.id %>/?settings">here</a>.
		</p>
	</div>
</div>

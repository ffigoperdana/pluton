# VM-only deployment configuration. Copy to .env and keep that file out of Git.
# Use a lower-case GHCR repository owned by the GitHub repository owner.
PLUTON_IMAGE=ghcr.io/replace-with-owner/replace-with-repository

# deploy.sh updates these two values. Do not use the moving main tag for production.
PLUTON_VERSION=v0.0.0
PLUTON_IMAGE_REF=

# Docker keeps application data in this named volume. Change only for a deliberate new install.
PLUTON_VOLUME_NAME=pluton-data
PLUTON_PORT=5173

# Set this once for a genuinely NEW installation, offline. Deploy/install never
# generate or rotate keys. Restore the original key for any existing /data volume.
ENCRYPTION_KEY=

# Set a strong password before running install.sh or deploy.sh.
USER_NAME=admin
USER_PASSWORD=CHANGE_ME_BEFORE_START

APP_TITLE=Pluton
APP_URL=http://localhost:5173
# Optional dual-origin web access. Use your canonical HTTPS APP_URL plus an explicitly approved LAN.
# APP_ALLOWED_ORIGINS=https://pluton.example.internal,http://192.0.2.10:5173
# Keep NEW Agent enrollment instructions private if desired; existing Agents are not rewritten.
# New standalone enrollments require all three reviewed distribution values; unset blocks token creation only.
# AGENT_INSTALL_REPOSITORY_URL=https://git.example.internal/agents/pluton-agent.git
# AGENT_INSTALL_COMMIT=<reviewed-full-40-character-lowercase-commit-sha>
# AGENT_INSTALL_VERSION=0.7.0
# Optional approved CA PEM path on the Agent host:
# AGENT_INSTALL_CA_FILE=/etc/ssl/certs/example-agent-ca.pem
# AGENT_SERVER_URL=http://192.0.2.10:5173
# ALLOW_INSECURE_AGENT_HTTP=true
MAX_CONCURRENT_BACKUPS=2
SESSION_DURATION=7
ALLOW_CUSTOM_RESTORE_PATH=true
ALLOW_FILE_BROWSER=true
DISABLE_EVENT_SCRIPTS=false

# Set when Pluton is behind a trusted reverse proxy.
# Not required for fixed approved web-origin mapping. For client IP rate limiting, use ONLY
# reviewed last-hop peer addresses/subnets, with firewall restrictions and overwritten headers.
# TRUST_PROXY=192.0.2.20/32

# Optional bounded health-check wait used by deploy.sh.
# PLUTON_HEALTH_ATTEMPTS=60

# compose.lab.yml, when present, is included automatically after compose.yml.
# Other approved overlays: create an operator-owned compose.overlays file containing
# installation-local basenames, one per line. Optional profiles are NOT auto-started.

# Optional Reliable Download uses a separate PRIVATE, versioned temporary bucket.
# Follow docs/MANAGED_RELIABLE_DOWNLOAD_UAT.md before explicit enablement.
MANAGED_EXPORT_ENABLED=false
# MANAGED_EXPORT_ENDPOINT=https://s3.example.internal
# MANAGED_EXPORT_REGION=us-east-1
# MANAGED_EXPORT_BUCKET=example-private-exports
# MANAGED_EXPORT_PREFIX=pluton-temporary-exports
# MANAGED_EXPORT_ACCESS_KEY_ID=YOUR_DEDICATED_EXPORT_ACCESS_KEY
# MANAGED_EXPORT_SECRET_ACCESS_KEY=YOUR_DEDICATED_EXPORT_SECRET_KEY
# MANAGED_EXPORT_SESSION_TOKEN=YOUR_TEMPORARY_SESSION_TOKEN
# MANAGED_EXPORT_TTL_SECONDS=259200
# Optional host file: add compose.managed-export-ca.yml to compose.overlays.
# MANAGED_EXPORT_CA_HOST_FILE=/etc/pluton/certificates/export-ca.pem

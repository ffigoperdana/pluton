# VM-only deployment configuration. Copy to .env and keep that file out of Git.
# Use a lower-case GHCR repository owned by the GitHub repository owner.
PLUTON_IMAGE=ghcr.io/replace-with-owner/replace-with-repository

# deploy.sh updates these two values. Do not use the moving main tag for production.
PLUTON_VERSION=v0.0.0
PLUTON_IMAGE_REF=

# Docker keeps application data in this named volume. Change only for a deliberate new install.
PLUTON_VOLUME_NAME=pluton-data
PLUTON_PORT=5173

# install.sh generates this on a new install when it is empty. Never rotate it while
# existing encrypted repositories or application data must remain usable.
ENCRYPTION_KEY=

# Set a strong password before running install.sh or deploy.sh.
USER_NAME=admin
USER_PASSWORD=CHANGE_ME_BEFORE_START

APP_TITLE=Pluton
APP_URL=http://localhost:5173
MAX_CONCURRENT_BACKUPS=2
SESSION_DURATION=7
ALLOW_CUSTOM_RESTORE_PATH=true
ALLOW_FILE_BROWSER=true
DISABLE_EVENT_SCRIPTS=false

# Set when Pluton is behind a trusted reverse proxy.
# TRUST_PROXY=1

# Optional bounded health-check wait used by deploy.sh.
# PLUTON_HEALTH_ATTEMPTS=30
